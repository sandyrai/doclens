# =========================================================
# AI Document Agent — configuration template
# =========================================================
# Copy this file to `.env` and fill in your values:
#
#     cp .env.example .env        (Windows: copy .env.example .env)
#
# `.env` is listed in .gitignore, so your keys never get
# committed. NEVER put real keys in this example file.
# =========================================================


# ---------------------------------------------------------
# 1. Pick ONE LLM provider
# ---------------------------------------------------------
# Local (free, private, no key):
#   ollama      Ollama native API        https://ollama.com
#   lmstudio    LM Studio local server   http://localhost:1234/v1
#
# Cloud (need an API key; many have free tiers):
#   openrouter  hundreds of models, incl. free ones
#   gemini      Google Gemini            (alias: google)
#   anthropic   Claude                   (alias: claude)
#   openai      OpenAI
#   groq        Groq
#
# Anything else that speaks the OpenAI API (vLLM, llama.cpp
# server, Together, DeepSeek, Mistral, Azure proxy, ...):
#   custom      + set LLM_BASE_URL below
LLM_PROVIDER=ollama


# ---------------------------------------------------------
# 2. Model(s) — comma-separated, tried IN ORDER
# ---------------------------------------------------------
# If the first model fails (removed, rate-limited, down),
# the next one is used automatically. Model names change
# often — check your provider's model list.
#
# Examples (verify the current names on the provider's site):
#   ollama:      LLM_MODELS=qwen3:8b,llama3.2:3b
#   openrouter:  LLM_MODELS=<model-a>:free,<model-b>:free
#                (browse https://openrouter.ai/models — filter
#                 by "free" and "tools")
#   gemini:      LLM_MODELS=gemini-2.5-flash
#   anthropic:   LLM_MODELS=claude-haiku-4-5
#   openai:      LLM_MODELS=gpt-4o-mini
#   groq:        LLM_MODELS=llama-3.3-70b-versatile
#   lmstudio:    LLM_MODELS=<model id shown in LM Studio>
#
# For ollama this defaults to qwen3:8b if left empty.
LLM_MODELS=qwen3:8b


# ---------------------------------------------------------
# 3. API key (cloud providers only)
# ---------------------------------------------------------
# Either set the generic LLM_API_KEY, or the provider's own
# variable. Keeping several provider keys here lets you
# switch by changing only LLM_PROVIDER.
LLM_API_KEY=

# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=


# ---------------------------------------------------------
# 4. Optional: custom endpoint
# ---------------------------------------------------------
# Required for LLM_PROVIDER=custom; for other providers it
# overrides the built-in URL (e.g. LM Studio on another port).
# LLM_BASE_URL=http://localhost:8000/v1


# ---------------------------------------------------------
# 5. Optional: reliability tuning (defaults shown)
# ---------------------------------------------------------
# LLM_MAX_RETRIES=1          # extra tries on HTTP 429 before moving on
# LLM_RETRY_DELAY=2          # seconds between those tries
# LLM_COOLDOWN_SECONDS=300   # skip a rate-limited model for this long
# LLM_TIMEOUT=120            # seconds per request
# LLM_MAX_TOKENS=            # cap answer length (defaults to 4096 for Claude)
# LLM_SYSTEM_PREFIX=         # text before the system prompt
                             # (auto "/no_think" for Qwen3 models)


# ---------------------------------------------------------
# 6. Optional: Ollama tuning (LLM_PROVIDER=ollama only)
# ---------------------------------------------------------
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_NUM_CTX=2048        # context window; smaller = faster on CPU
# OLLAMA_NUM_THREAD=         # CPU threads; empty = Ollama decides
# OLLAMA_KEEP_ALIVE=30m      # keep model loaded between questions


# ---------------------------------------------------------
# 7. Embeddings (document search) — always via local Ollama
# ---------------------------------------------------------
# EMBEDDING_MODEL=nomic-embed-text   # changing it = re-upload documents


# ---------------------------------------------------------
# 8. Document store — PostgreSQL + pgvector
# ---------------------------------------------------------
# `docker compose up -d db` starts a matching local database.
DATABASE_URL=postgresql://doclens:doclens@127.0.0.1:5432/doclens
# DB_POOL_SIZE=5
# DB_TIMEOUT=10              # seconds to wait for a connection


# ---------------------------------------------------------
# 9. Public deployment: per-visitor isolation
# ---------------------------------------------------------
# true  -> each browser (anonymous cookie) and each WebSocket
#          API key gets a private document space; documents,
#          chat sessions and cached answers are not shared.
# false -> single-user mode: everything is shared (local use).
VISITOR_ISOLATION=false
# Days to keep a visitor's documents before deleting them.
# VISITOR_RETENTION_DAYS=7


# ---------------------------------------------------------
# Usage limits for anonymous visitors (per day)
# ---------------------------------------------------------
ANON_MAX_UPLOADS=1
ANON_MAX_QUESTIONS=15


# ---------------------------------------------------------
# Deployment behind a reverse proxy
# ---------------------------------------------------------
# Only set this to true when the app runs behind a proxy you
# control (nginx, Cloudflare, a load balancer). It makes the
# rate limiter trust the X-Forwarded-For header. Leave it
# false for local use, or clients could fake their IP.
TRUST_PROXY_HEADERS=false
