# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Uploaded files and vector database
uploads/
chroma_db/

# OCR text cache (contains text from uploaded documents)
ocr_cache/

# Chat history database (personal conversation data)
data/

# Environment variables (contains API keys!)
# NEVER commit these — they hold your LLM provider keys.
# Only the placeholder template .env.example is committed.
.env
.env.*
!.env.example
*.env

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo

# pytest cache
.pytest_cache/

# OS files
Thumbs.db
.DS_Store

# Logs (can contain provider error details)
*.log
logs/
